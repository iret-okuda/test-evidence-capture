{
  "manifest_version": 3,
  "name": "Test Evidence Capture",
  "version": "0.1.0",
  "description": "Select DOM elements and save their viewport area as a PNG test artifact.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "撮影モードを開始",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bounds.js",
        "annotations.js",
        "filename.js",
        "storage.js",
        "history.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "start-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start DOM screenshot capture mode"
    }
  }
}
